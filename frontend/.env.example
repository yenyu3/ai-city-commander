VITE_MAPBOX_TOKEN=your_mapbox_token_here

# "api"：呼叫真實後端 API（預設，首屏不載入 demo 事件/結果）
# "demo"：使用 frontend/public/data 下的靜態資料集
VITE_DATA_SOURCE=api

# 前端呼叫後端 API 時使用的 base path
VITE_API_BASE_URL=/api

# 僅供本機開發用：設定後 vite dev server 會把 /api 開頭的請求 proxy 過去，
# 避免瀏覽器端直接打後端造成 CORS 問題。留空則不啟用 proxy。
VITE_API_PROXY_TARGET=
