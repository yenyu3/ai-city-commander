VITE_MAPBOX_TOKEN=your_mapbox_token_here

# "api": call the backend API. No demo incidents/results are loaded.
# "demo": load static files from frontend/public/data.
VITE_DATA_SOURCE=api

# Browser API base URL.
# Keep "/api" when using the Vite proxy below.
# For a direct local backend URL without proxy, use "http://127.0.0.1:8787/api".
VITE_API_BASE_URL=/api

# Optional Vite dev proxy target.
# Remote example: https://example.execute-api.us-west-2.amazonaws.com/
# Local backend example: http://127.0.0.1:8787
VITE_API_PROXY_TARGET=

# Optional Vite dev proxy target for "/public/*" (the CloudFront-served
# public-results bucket). Needed locally because that bucket has no CORS
# policy: the browser can only read it same-origin, which is only true in
# production (frontend + /public/* share the same CloudFront distribution).
# Value: the CloudFront domain from terraform output "frontend_url", e.g.
# https://example.cloudfront.net
VITE_PUBLIC_RESULTS_BASE_URL=
